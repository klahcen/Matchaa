# Matcha Backend - Environment Configuration Example
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file (it's in .gitignore)

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=matcha_db

# JWT Authentication
# Use a strong random string (min 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# Resend API (Email Delivery)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender domain/email from Resend (or use onboarding@resend.dev for sandbox)
MAIL_FROM=onboarding@resend.dev

# Application URLs (for email links)
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# CORS allowed origins (comma-separated)
# Use '*' for all origins in development, or specify exact origins like:
# https://app.example.com,https://www.example.com in production
CORS_ORIGIN=*

# Pexels API (SEED SCRIPT ONLY - backend/scripts/seedFakeProfiles.ts)
# Get your API key from https://www.pexels.com/api/
PEXELS_API_KEY=

# File Uploads (local storage path)
UPLOAD_DIR=./uploads